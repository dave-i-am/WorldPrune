{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "useBaseBranchConfig": "merge",
  "customDatasources": {
    "papermc": {
      "defaultRegistryUrlTemplate": "https://api.papermc.io/v2/projects/paper",
      "transformTemplates": [
        "{\"releases\": $.versions.{\"version\": $}, \"sourceUrl\": \"https://papermc.io\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Minecraft server version in docker-compose.yml",
      "managerFilePatterns": [
        "/^docker-compose\\.yml$/"
      ],
      "matchStrings": ["VERSION: \"(?<currentValue>[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)\""],
      "depNameTemplate": "paper",
      "datasourceTemplate": "custom.papermc",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
